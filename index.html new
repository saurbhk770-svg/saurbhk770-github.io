<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AIMT CampusAI</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--bg:#050611;
--card:#11162b;
--red:#ff2450;
--purple:#874cff;
--cyan:#20d9ff;
--white:#f7f8ff;
--muted:#aab0c5;
}

html{scroll-behavior:smooth}

body{
font-family:Arial,Helvetica,sans-serif;
color:var(--white);
background:
radial-gradient(circle at 10% 10%,#35105b,transparent 30%),
radial-gradient(circle at 90% 5%,#063c50,transparent 28%),
var(--bg);
line-height:1.6;
overflow-x:hidden;
}

body:before{
content:"";
position:fixed;
inset:0;
pointer-events:none;
background-image:
linear-gradient(#ffffff08 1px,transparent 1px),
linear-gradient(90deg,#ffffff08 1px,transparent 1px);
background-size:45px 45px;
}

/* NAVBAR */

nav{
position:sticky;
top:10px;
z-index:20;
max-width:1150px;
margin:10px auto;
padding:13px 18px;
border:1px solid #ffffff20;
border-radius:22px;
background:#050611cc;
backdrop-filter:blur(18px);
display:flex;
justify-content:space-between;
align-items:center;
}

.brand{
display:flex;
align-items:center;
gap:12px;
font-weight:bold;
}

.logo{
width:44px;
height:44px;
border-radius:14px;
display:grid;
place-items:center;
font-size:20px;
font-weight:900;
background:linear-gradient(135deg,var(--red),var(--purple));
box-shadow:0 0 25px #ff245066;
}

.brand small{
display:block;
color:var(--muted);
font-size:9px;
letter-spacing:2px;
}

nav a{
color:#ddd;
text-decoration:none;
margin-left:18px;
font-size:14px;
}

nav a:hover{color:var(--cyan)}

/* HERO */

.hero{
max-width:1150px;
margin:55px auto 30px;
padding:25px 22px;
display:grid;
grid-template-columns:1.2fr .8fr;
gap:35px;
align-items:center;
}

.badge{
display:inline-block;
padding:8px 14px;
border:1px solid #ff245055;
border-radius:30px;
color:#ff718c;
font-size:11px;
letter-spacing:1.5px;
}

h1{
font-size:clamp(50px,8vw,90px);
line-height:.92;
margin:20px 0;
background:linear-gradient(
100deg,#fff,#ff2450,#914cff,#20d9ff
);
-webkit-background-clip:text;
color:transparent;
}

.hero p{
color:var(--muted);
font-size:17px;
max-width:650px;
}

.buttons{
display:flex;
gap:12px;
margin-top:25px;
flex-wrap:wrap;
}

.btn{
padding:13px 20px;
border-radius:14px;
color:white;
text-decoration:none;
font-weight:bold;
background:linear-gradient(135deg,var(--red),var(--purple));
box-shadow:0 12px 35px #7540ff33;
}

.btn.alt{
background:#ffffff08;
border:1px solid #ffffff20;
}

/* 3D CUBE */

.scene{
height:350px;
display:grid;
place-items:center;
perspective:900px;
}

.cube{
width:190px;
height:190px;
position:relative;
transform-style:preserve-3d;
animation:rotate 12s linear infinite;
}

.face{
position:absolute;
width:190px;
height:190px;
border:1px solid #ffffff35;
background:linear-gradient(
135deg,#ff245044,#7540ff33
);
display:grid;
place-items:center;
font-size:25px;
font-weight:900;
box-shadow:inset 0 0 50px #20d9ff12;
}

.front{transform:translateZ(95px)}
.back{transform:rotateY(180deg) translateZ(95px)}
.right{transform:rotateY(90deg) translateZ(95px)}
.left{transform:rotateY(-90deg) translateZ(95px)}
.top{transform:rotateX(90deg) translateZ(95px)}
.bottom{transform:rotateX(-90deg) translateZ(95px)}

@keyframes rotate{
from{transform:rotateX(0) rotateY(0)}
to{transform:rotateX(360deg) rotateY(360deg)}
}

/* SECTIONS */

section{
max-width:1150px;
margin:55px auto;
padding:0 22px;
}

.title{
margin-bottom:22px;
}

.title h2{
font-size:30px;
}

.title p{
color:var(--muted);
font-size:13px;
}

/* SEARCH */

.search-box{
display:flex;
gap:10px;
margin-bottom:18px;
}

.search-box input{
flex:1;
padding:16px;
border-radius:15px;
border:1px solid #ffffff20;
background:#ffffff09;
color:white;
outline:none;
font-size:16px;
}

.search-box input::placeholder{
color:#858ba0;
}

.search-box button{
padding:0 22px;
border:0;
border-radius:15px;
color:white;
font-weight:bold;
cursor:pointer;
background:linear-gradient(135deg,var(--red),var(--purple));
}

#searchStatus{
color:var(--muted);
font-size:13px;
margin-bottom:18px;
}

.results{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:15px;
}

.result{
padding:18px;
border:1px solid #ffffff18;
border-radius:18px;
background:#ffffff07;
}

.result span{
color:var(--cyan);
font-size:10px;
font-weight:bold;
letter-spacing:1px;
}

.result h3{
margin:8px 0;
}

.result p{
color:var(--muted);
font-size:14px;
}

/* CARDS */

.grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:18px;
}

.card{
position:relative;
padding:22px;
border:1px solid #ffffff18;
border-radius:22px;
background:linear-gradient(
145deg,#ffffff0b,#ffffff03
);
box-shadow:0 20px 50px #0007;
transition:.3s;
overflow:hidden;
}

.card:hover{
transform:translateY(-8px);
border-color:#ffffff35;
}

.card h3{
margin:10px 0 7px;
}

.card p{
color:var(--muted);
font-size:14px;
}

.icon{
font-size:30px;
}

.tag{
display:inline-block;
margin-top:14px;
padding:5px 9px;
border-radius:8px;
background:#ffffff0b;
font-size:10px;
color:#cdd3e5;
}

/* FAQ */

details{
background:#ffffff07;
border:1px solid #ffffff15;
border-radius:15px;
padding:16px;
margin:10px 0;
}

summary{
font-weight:bold;
cursor:pointer;
}

details p{
color:var(--muted);
padding-top:10px;
}

/* CONTACT */

.contact{
display:grid;
grid-template-columns:1fr 1fr;
gap:18px;
}

/* FOOTER */

footer{
margin-top:80px;
padding:35px 20px;
text-align:center;
border-top:1px solid #ffffff15;
color:var(--muted);
font-size:13px;
}

/* MOBILE */

@media(max-width:800px){

nav{
margin:7px;
}

.links{
display:none;
}

.hero{
grid-template-columns:1fr;
margin-top:30px;
}

.grid,
.results,
.contact{
grid-template-columns:1fr;
}

.scene{
height:270px;
}

.cube,
.face{
width:150px;
height:150px;
}

.front{transform:translateZ(75px)}
.back{transform:rotateY(180deg) translateZ(75px)}
.right{transform:rotateY(90deg) translateZ(75px)}
.left{transform:rotateY(-90deg) translateZ(75px)}
.top{transform:rotateX(90deg) translateZ(75px)}
.bottom{transform:rotateX(-90deg) translateZ(75px)}

.search-box{
flex-direction:column;
}

.search-box button{
padding:14px;
}

}

</style>
</head>

