<script>

/* CAMPUS SEARCH DATABASE */

const campusData=[

{
type:"NOTICE",
title:"AKTU Grievance Portal",
text:"Online grievance facility operational from 04 August 2026 for examination results, re-evaluation, marks, marksheets and degree issues."
},

{
type:"NOTICE",
title:"Odd Semester Classes",
text:"Odd semester classes commenced from 01 August 2026."
},

{
type:"NOTICE",
title:"Late Fee",
text:"A ₹1,000 late fee was notified for unpaid semester fee, bus fee or other applicable dues."
},

{
type:"EVENT",
title:"Technical Quiz Arena 2.0",
text:"10 August 2026. Enigma Technical Club. CNC Lab at 2:20 PM."
},

{
type:"EVENT",
title:"Smart Ambalika Hackathon",
text:"17–18 August 2026. Six-member team including at least one female member."
},

{
type:"EVENT",
title:"Spark-O-Fest 2.0",
text:"28–29 November 2026. Start-up pitch, ideathon and innovation display."
},

{
type:"FACULTY",
title:"HOD",
text:"Alok Mishra is the CSE HOD."
},

{
type:"FACULTY",
title:"Deputy HOD",
text:"Vipin Rawat is the CSE Deputy HOD."
},

{
type:"LAB",
title:"Data Structures Using C",
text:"BCS351. Faculty: Mr. Arvind Kumar. Lab-4, 3rd Floor."
},

{
type:"LAB",
title:"Web Designing Workshop",
text:"BCS353. Faculty: Mr. Tushar Kanoujia. Lab-3, 3rd Floor."
},

{
type:"LAB",
title:"Java Training",
text:"JAVA-S3. Room 406, 3rd Floor."
},

{
type:"ACADEMIC",
title:"CSE Classroom",
text:"B.Tech CSE Year 2 SEC-C, Room 406, 3rd Floor."
},

{
type:"CONTACT",
title:"Main Campus",
text:"Maurawan Road, Mohanlalganj, Lucknow, Uttar Pradesh – 226301."
},

{
type:"CONTACT",
title:"Head Office",
text:"Ambalika Building, Subhash Marg, Near Sudarshan Cinema, Charbagh, Lucknow."
},

{
type:"TEAM",
title:"Pragati Gupta",
text:"Team Member of AIMT CampusAI."
},

{
type:"TEAM",
title:"Project Team",
text:"Saurabh Kumar, Iqra Fatima, Pragati Gupta, Akanksha Gupta, Shujal Kushwaha and Shoel Bharti."
}

];


/* SEARCH FUNCTION */

function searchCampus(){

let input=document
.getElementById("searchInput")
.value
.toLowerCase()
.trim();

let results=document.getElementById("results");

let status=document.getElementById("searchStatus");

if(input===""){

results.innerHTML="";

status.innerText=
"Start typing to search the campus knowledge base.";

return;

}

let found=campusData.filter(item=>

(item.type+" "+item.title+" "+item.text)
.toLowerCase()
.includes(input)

);


if(found.length===0){

results.innerHTML="";

status.innerText=
"No matching information found. Try another keyword.";

return;

}


status.innerText=
found.length+
(found.length===1?" result":" results")+
" found";


results.innerHTML=found.map(item=>`

<div class="result">

<span>${item.type}</span>

<h3>${item.title}</h3>

<p>${item.text}</p>

</div>

`).join("");

}


/* LIVE SEARCH */

document
.getElementById("searchInput")
.addEventListener("input",searchCampus);


/* ENTER KEY */

document
.getElementById("searchInput")
.addEventListener("keydown",function(e){

if(e.key==="Enter"){

searchCampus();

}

});

</script>

