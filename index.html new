<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIMT CampusAI</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
}

body{
    min-height:100vh;
    background:linear-gradient(135deg,#050816,#0b1630,#111b3d);
    color:white;
}

/* Header */
header{
    padding:25px 8%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    border-bottom:1px solid rgba(255,255,255,.12);
}

.logo{
    font-size:26px;
    font-weight:bold;
    color:#35d8ff;
}

nav a{
    color:white;
    text-decoration:none;
    margin-left:25px;
}

/* Hero */
.hero{
    min-height:75vh;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:30px;
}

.hero h1{
    font-size:clamp(45px,8vw,85px);
    background:linear-gradient(90deg,#35d8ff,#8c63ff);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    margin-top:20px;
    max-width:700px;
    color:#b7c4df;
    font-size:18px;
}

.btn{
    margin-top:30px;
    padding:14px 28px;
    border:none;
    border-radius:30px;
    background:#35d8ff;
    color:#06101e;
    font-weight:bold;
    cursor:pointer;
}

/* Chat Button */
.chat-button{
    position:fixed;
    right:25px;
    bottom:25px;
    width:65px;
    height:65px;
    border-radius:50%;
    border:none;
    background:linear-gradient(135deg,#35d8ff,#795cff);
    color:white;
    font-size:28px;
    cursor:pointer;
    box-shadow:0 0 30px rgba(53,216,255,.45);
    z-index:1000;
}

/* Chat Window */
.chat-box{
    position:fixed;
    right:25px;
    bottom:105px;
    width:360px;
    max-width:calc(100% - 30px);
    height:520px;
    background:#0c1730;
    border:1px solid rgba(53,216,255,.35);
    border-radius:22px;
    box-shadow:0 20px 60px rgba(0,0,0,.55);
    display:none;
    flex-direction:column;
    overflow:hidden;
    z-index:999;
}

.chat-header{
    padding:18px;
    background:linear-gradient(135deg,#14274b,#172052);
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.chat-title{
    font-weight:bold;
}

.chat-title small{
    display:block;
    color:#35d8ff;
    margin-top:4px;
    font-size:11px;
}

.close{
    border:none;
    background:none;
    color:white;
    font-size:22px;
    cursor:pointer;
}

.messages{
    flex:1;
    padding:15px;
    overflow-y:auto;
}

.message{
    max-width:85%;
    padding:11px 14px;
    margin-bottom:12px;
    border-radius:15px;
    line-height:1.4;
    font-size:14px;
}

.bot{
    background:#172642;
    border-bottom-left-radius:4px;
}

.user{
    background:#256d9d;
    margin-left:auto;
    border-bottom-right-radius:4px;
}

.quick{
    padding:8px 12px;
    display:flex;
    gap:6px;
    overflow-x:auto;
}

.quick button{
    white-space:nowrap;
    border:1px solid #2e537a;
    background:#101f38;
    color:#bfeeff;
    padding:7px 10px;
    border-radius:15px;
    cursor:pointer;
}

.input-area{
    display:flex;
    padding:12px;
    gap:8px;
    border-top:1px solid rgba(255,255,255,.1);
}

.input-area input{
    flex:1;
    background:#101d34;
    border:1px solid #29466b;
    color:white;
    padding:12px;
    border-radius:20px;
    outline:none;
}

.input-area button{
    width:45px;
    border:none;
    border-radius:50%;
    background:#35d8ff;
    cursor:pointer;
}

@media(max-width:500px){
    .chat-box{
        right:15px;
        bottom:95px;
        width:calc(100% - 30px);
    }

    nav{
        display:none;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">🤖 AIMT CampusAI</div>

    <nav>
        <a href="#">Home</a>
        <a href="#about">About</a>
        <a href="#events">Events</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section class="hero">

    <h1>CampusAI</h1>

    <p>
        Your smart AIMT campus assistant.
        Ask about departments, faculty, events, notices,
        contact information and campus services.
    </p>

    <button class="btn" onclick="openChat()">
        💬 Ask CampusAI
    </button>

</section>


<!-- Floating Chat Button -->

<button class="chat-button" onclick="toggleChat()">
    🤖
</button>


<!-- Chat Window -->

<div class="chat-box" id="chatBox">

    <div class="chat-header">

        <div class="chat-title">
            🤖 AIMT CampusAI
            <small>● Online • AIMT Knowledge Assistant</small>
        </div>

        <button class="close" onclick="closeChat()">×</button>

    </div>


    <div class="messages" id="messages">

        <div class="message bot">
            👋 Hello! I'm <b>AIMT CampusAI</b>.<br><br>
            Ask me anything about AIMT College, CSE,
            faculty, events, notices or contact details.
        </div>

    </div>


    <div class="quick">

        <button onclick="quickAsk('Who is the CSE HOD?')">
            CSE HOD
        </button>

        <button onclick="quickAsk('What is the college address?')">
            Address
        </button>

        <button onclick="quickAsk('Tell me about CSE workshops')">
            Workshops
        </button>

        <button onclick="quickAsk('Give me contact numbers')">
            Contact
        </button>

    </div>


    <div class="input-area">

        <input
            id="userInput"
            type="text"
            placeholder="Ask something..."
            onkeydown="if(event.key==='Enter') sendMessage()"
        >

        <button onclick="sendMessage()">➤</button>

    </div>

</div>


<script>

/* ============================
   AIMT KNOWLEDGE BASE
============================ */

const knowledge = {

    hod: `
    The Head of Department (HOD) of CSE is
    <b>Alok Mishra</b>.
    `,

    deputyhod: `
    The Deputy HOD of CSE is
    <b>Vipin Rawat</b>.
    `,

    address: `
    <b>AIMT College Address:</b><br><br>
    Maurawan Road, Mohanlalganj,<br>
    Lucknow, Uttar Pradesh - 226301.
    <br><br>
    <b>Head Office:</b><br>
    Ambalika Building, Subhash Marg,
    Near Sudarshan Cinema, Charbagh,
    Lucknow, Uttar Pradesh.
    `,

    contact: `
    <b>Admission:</b><br>
    +91 96518 28006<br>
    +91 96518 28007
    <br><br>

    <b>General:</b><br>
    +91 78804 99924<br>
    +91 78804 99970
    <br><br>

    <b>Administrative Office:</b><br>
    +91 94151 58766
    <br><br>

    <b>Landline:</b><br>
    0522-2962493
    `,

    labs: `
    CSE-related practical/training activities include:
    <br><br>
    • Web Designing Workshop<br>
    • Data Structure Using C<br>
    • Mini Project / Internship Assessment<br>
    • Java Training
    `,

    team: `
    <b>Project Team:</b><br><br>
    • Saurabh Kumar<br>
    • Iqra Fatima<br>
    • Pragati Gupta<br>
    • Akanksha Gupta<br>
    • Shujal Kushwaha<br>
    • Shoel Bharti
    `,

    project: `
    <b>AIMT CampusAI</b> is an AI-inspired
    student information and assistance platform.
    <br><br>
    It helps students find campus information,
    faculty details, events, notices and useful
    services from one place.
    `,

    hackathon: `
    AIMT CampusAI is designed as a hackathon
    project focused on creating a smart,
    student-friendly campus assistant.
    `
};


/* ============================
   CHAT FUNCTIONS
============================ */

function toggleChat(){

    const box=document.getElementById("chatBox");

    if(box.style.display==="flex"){
        box.style.display="none";
    }
    else{
        box.style.display="flex";
        document.getElementById("userInput").focus();
    }
}


function openChat(){

    document.getElementById("chatBox").style.display="flex";

    document.getElementById("userInput").focus();

}


function closeChat(){

    document.getElementById("chatBox").style.display="none";

}


function addMessage(text,type){

    const messages=document.getElementById("messages");

    const div=document.createElement("div");

    div.className="message "+type;

    div.innerHTML=text;

    messages.appendChild(div);

    messages.scrollTop=messages.scrollHeight;

}


function quickAsk(question){

    document.getElementById("userInput").value=question;

    sendMessage();

}


function sendMessage(){

    const input=document.getElementById("userInput");

    const question=input.value.trim();

    if(!question) return;

    addMessage(question,"user");

    input.value="";

    setTimeout(()=>{

        const answer=getAnswer(question);

        addMessage(answer,"bot");

    },400);

}


/* ============================
   AI-LIKE RESPONSE ENGINE
============================ */

function getAnswer(question){

    const q=question.toLowerCase();


    /* HOD */

    if(
        q.includes("hod") ||
        q.includes("head of department") ||
        q.includes("cse head")
    ){

        return knowledge.hod;

    }


    /* Deputy HOD */

    if(
        q.includes("deputy") ||
        q.includes("vice hod")
    ){

        return knowledge.deputyhod;

    }


    /* Address */

    if(
        q.includes("address") ||
        q.includes("location") ||
        q.includes("where is college") ||
        q.includes("college kaha")
    ){

        return knowledge.address;

    }


    /* Contact */

    if(
        q.includes("contact") ||
        q.includes("phone") ||
        q.includes("mobile") ||
        q.includes("admission number") ||
        q.includes("number")
    ){

        return knowledge.contact;

    }


    /* Workshops / Labs */

    if(
        q.includes("workshop") ||
        q.includes("lab") ||
        q.includes("training") ||
        q.includes("java") ||
        q.includes("data structure")
    ){

        return knowledge.labs;

    }


    /* Team */

    if(
        q.includes("team") ||
        q.includes("members") ||
        q.includes("member")
    ){

        return knowledge.team;

    }


    /* Project */

    if(
        q.includes("project") ||
        q.includes("campusai") ||
        q.includes("what is this")
    ){

        return knowledge.project;

    }


    /* Hackathon */

    if(
        q.includes("hackathon") ||
        q.includes("competition")
    ){

        return knowledge.hackathon;

    }


    /* Greetings */

    if(
        q.includes("hello") ||
        q.includes("hi") ||
        q.includes("hey")
    ){

        return `
        👋 Hello! Welcome to <b>AIMT CampusAI</b>.<br><br>
        You can ask me about <b>faculty, CSE,
        address, contact, workshops, events,
        hackathon or our project</b>.
        `;

    }


    /* Thanks */

    if(
        q.includes("thank") ||
        q.includes("thanks")
    ){

        return `
        You're welcome! 😊<br>
        I'm always here to help with AIMT-related queries.
        `;

    }


    /* Default */

    return `
    🤔 I don't have that information yet.
    <br><br>
    Try asking:
    <br>
    • Who is the CSE HOD?<br>
    • What is the college address?<br>
    • Give me contact numbers<br>
    • Tell me about CSE workshops<br>
    • Who are the project members?<br>
    • Tell me about the hackathon
    `;

}

</script>

</body>
</html>
